# VahanGrid Frontend — Environment Configuration Template
# Copy this file to .env and configure for your environment.

VITE_APP_NAME=VahanGrid
VITE_APP_TAGLINE="One Platform. Multiple Charging Networks. Seamless EV Mobility."

# Tile Server URLs for Leaflet Map Views
VITE_CARTO_DARK_URL=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png
VITE_CARTO_VOYAGER_URL=https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png

# Geocoding & Routing Services (Free OpenStreetMap / Photon / OSRM endpoints)
VITE_PHOTON_API_URL=https://photon.komoot.io/api
VITE_OSRM_ROUTING_URL=https://router.project-osrm.org/route/v1/driving/

# Backend API Service URL
# Local Development: http://localhost:3001/api/v1
# Production (Behind Reverse Proxy): /api/v1
# Production (Separate Domain): https://api.vahangrid.com/api/v1
VITE_API_BASE_URL=http://localhost:3001/api/v1
