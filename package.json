{
  "name": "vahangrid-monorepo",
  "version": "1.0.0",
  "description": "VahanGrid — Unified EV Charging & Mobility Ecosystem (monorepo root)",
  "private": true,
  "scripts": {
    "frontend": "npm run dev --prefix frontend",
    "backend": "npm run dev --prefix backend",
    "install:frontend": "npm install --prefix frontend",
    "install:backend": "npm install --prefix backend",
    "install:all": "npm run install:frontend && npm run install:backend",
    "build:frontend": "npm run build --prefix frontend",
    "db:migrate": "npm run migrate --prefix backend",
    "db:seed": "npm run seed --prefix backend",
    "db:verify": "npm run verify:db --prefix backend",
    "test": "npm run test --prefix backend",
    "test:all": "npm run test:all --prefix backend"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
