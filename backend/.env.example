# VahanGrid Backend — Environment Configuration Template
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# Reverse Proxy Trust Configuration:
# Set to 1 (or true) when running behind a reverse proxy (e.g. NGINX, Cloudflare, AWS ALB).
# In production, this defaults to 1 so X-Forwarded-* headers are parsed correctly.
TRUST_PROXY=1

# ── Database ─────────────────────────────────────────────────────────────────
# Full PostgreSQL connection string. Format:
# postgresql://<user>:<password>@<host>:<port>/<database>
#
# In production:
# - Must start with postgresql:// or postgres://
# - Recommended to use SSL (e.g. ?sslmode=require)
#
# Example (local):
# DATABASE_URL=postgresql://vahangrid_user:your_password@localhost:5432/vahangrid_db
#
# Example (cloud — AWS RDS / Neon / Supabase):
# DATABASE_URL=postgresql://...
DATABASE_URL=

# ── Frontend & CORS ──────────────────────────────────────────────────────────
# Allowed origins for CORS and cookie delivery.
# In development: http://localhost:5173
# In production: provide full domain (e.g. https://vahangrid.com) or comma-separated list
# Example: https://vahangrid.com,https://admin.vahangrid.com
FRONTEND_URL=http://localhost:5173

# ── Authentication ────────────────────────────────────────────────────────────
# JWT signing secret. MUST be a long, random, secret string.
# In production, this MUST be at least 32 characters long and not use placeholder values.
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# NEVER commit the real value. NEVER use a simple or guessable string.
JWT_SECRET=

# How long a JWT stays valid before the user must log in again.
# Supported formats: 60 (seconds), 15m, 7d, 1h, 30d
# Default if not set: 7d
JWT_EXPIRES_IN=7d

# ── Payment Gateway (Phase 3E.4) ──────────────────────────────────────────────
# Gateway provider name. Default: razorpay
PAYMENT_PROVIDER=razorpay

# Provider Key ID (e.g. rzp_test_... or rzp_live_...)
PAYMENT_PROVIDER_KEY=

# Provider Key Secret (keep secret; never commit or leak)
PAYMENT_PROVIDER_SECRET=

# Gateway Webhook Secret used to verify HMAC-SHA256 signature in x-razorpay-signature header
PAYMENT_WEBHOOK_SECRET=
