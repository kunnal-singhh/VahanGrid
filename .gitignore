# Root-level gitignore for VahanGrid monorepo
#
# Each sub-project (frontend/, backend/) has its own .gitignore for
# project-specific rules. This file covers things at the repo root.

# OS artifacts
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Secrets — belt-and-suspenders: each subdir also ignores .env
.env
*.local

# Logs
*.log
npm-debug.log*
